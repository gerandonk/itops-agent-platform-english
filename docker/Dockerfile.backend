# ITOps Agent Platform - Backend
# Multi-stage build optimized for production and public registry distribution
# Build: docker build -f docker/Dockerfile.backend -t itops-backend:latest .

# ============================================================
# Build-time arguments (overridable via --build-arg)
# ============================================================
# APT mirror for China users; pass empty string to keep Debian defaults
#   docker build --build-arg APT_MIRROR= -f docker/Dockerfile.backend .
# Enterprise/intranet environments can set a proxy or use a local mirror:
#   docker build --build-arg HTTP_PROXY=http://proxy:8080 --build-arg HTTPS_PROXY=http://proxy:8080 \
#                --build-arg APT_MIRROR= -f docker/Dockerfile.backend .
ARG APT_MIRROR=mirrors.aliyun.com
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=localhost,127.0.0.1

# ============================================================
# Stage 1: Builder
# ============================================================
FROM node:20.19.5-alpine AS builder

ARG APT_MIRROR
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY}

# Use Aliyun APK mirror for Alpine in China (optional)
# Set APK_MIRROR="" to keep official mirrors
RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i 's|http://dl-cdn.alpinelinux.org|http://mirrors.aliyun.com/alpine|g' /etc/apk/repositories; \
    fi

WORKDIR /app

# Install build dependencies for native modules (better-sqlite3)
RUN apk add --no-cache --virtual .build-deps \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

# Copy package files first for better layer caching
COPY backend/package.json backend/package-lock.json ./

# Install all dependencies (including devDependencies for tsx) and build native modules
# Use npmmirror for China; override with --build-arg NPM_REGISTRY= for other mirrors/proxies
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN --mount=type=cache,target=/root/.npm \
    if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi && \
    npm ci --prefer-offline --no-audit

# Copy source code
COPY backend/ ./

# Remove devDependencies to reduce size before copying to production stage
RUN npm prune --omit=dev --no-save

# Clean up build dependencies and npm cache
RUN apk del .build-deps && rm -rf /root/.npm /root/.node-gyp

# ============================================================
# Stage 2: Production
# ============================================================
FROM node:20.19.5-alpine

ARG APT_MIRROR
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY}

# Use Aliyun APK mirror for Alpine in China (optional)
RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i 's|http://dl-cdn.alpinelinux.org|http://mirrors.aliyun.com/alpine|g' /etc/apk/repositories; \
    fi

# Labels for public registry (replace with your actual info)
LABEL maintainer="谭策 <huawei_network@foxmail.com>" \
    org.opencontainers.image.title="ITOps Agent Platform Backend" \
    org.opencontainers.image.description="Enterprise IT Operations Multi-Agent Automation Platform - Backend API Server" \
    org.opencontainers.image.source="https://github.com/qinshihu/itops-agent-platform" \
    org.opencontainers.image.licenses="MPL-2.0" \
    org.opencontainers.image.vendor="谭策" \
    org.opencontainers.image.url="https://www.zjzwfw.cloud/ITOpsAgentinfo"

# Set working directory
WORKDIR /app

# Environment variables
ENV NODE_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0

# Clear build-time proxy settings so they don't leak into the runtime container
ENV http_proxy= \
    https_proxy= \
    no_proxy=

# Install minimal runtime dependencies (sqlite library, gosu for privilege drop)
RUN apk add --no-cache \
    sqlite \
    gosu \
    && rm -rf /var/cache/apk/*

# Copy all from builder except node_modules (which stays in builder)
# Use a more efficient approach: copy built application
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src ./src

# Strip node_modules from common non-production packages
RUN find /app/node_modules -type d -name .bin -exec rm -rf {} + 2>/dev/null || true && \
    find /app/node_modules -type f -name "*.map" -delete && \
    find /app/node_modules -type f \( -name "*.md" -o -name "*.txt" -o -name "LICENSE*" \) -delete

# Copy package.json for reference
COPY backend/package.json ./

# Copy entrypoint script
COPY docker/docker-entrypoint-backend.sh /usr/local/bin/docker-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh && chmod +x /usr/local/bin/docker-entrypoint.sh

# Create non-root user and set ownership in one command
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup && \
    mkdir -p /app/data && \
    chown -R appuser:appgroup /app

# Expose API port
EXPOSE 3001

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3001/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use entrypoint script for proper volume permission handling
ENTRYPOINT ["docker-entrypoint.sh"]

# Start the application using tsx (TypeScript runtime, no pre-compilation needed)
CMD ["npx", "tsx", "src/app.ts"]
